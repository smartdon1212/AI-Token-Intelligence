# AI Token Intelligence Environment Variables

# GEMINI_API_KEY: Optional API key for Google Gemini model evaluation and reasoning.
# Set via AI Studio Secrets panel. The core prototype functions independently without this.
GEMINI_API_KEY=""

# Application Host and Port
APP_PORT=3000
FASTAPI_PORT=8000
APP_URL="http://localhost:3000"

# Research Prototype Configuration
DATABASE_PATH="ai_token_intelligence.db"
DEFAULT_PRICING_VERSION="2025-01"
ALLOW_SYNTHETIC_DATA=true
LOG_LEVEL="INFO"
